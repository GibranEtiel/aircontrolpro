# Copia este archivo como `.env` (queda fuera de git) o define las mismas variables en cPanel.

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.aircontrolpro.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.aircontrolpro.cl

# Base de datos creada en cPanel → «Bases de datos MySQL» (cPanel antepone tu usuario: usuario_nombre)
DB_NAME=usuario_aircontrol
DB_USER=usuario_aircontrol
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Correo para el aviso diario de cotizaciones por llamar (crea una cuenta en cPanel → Cuentas de correo)
EMAIL_HOST=mail.aircontrolpro.cl
EMAIL_PORT=465
EMAIL_HOST_USER=avisos@aircontrolpro.cl
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
DEFAULT_FROM_EMAIL=Air Control Pro <avisos@aircontrolpro.cl>
AVISOS_EMAIL=contacto@aircontrolpro.cl

# Días sin respuesta para que una cotización aparezca como «por llamar»
COTIZACION_DIAS_ALERTA=3
